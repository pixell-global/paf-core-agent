# PAF Core Agent - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Provider Configuration (At least one required)
# ============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude
#ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# AWS Bedrock
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=your-aws-access-key
#AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ============================================================================
# Agent Configuration
# ============================================================================

DEFAULT_MODEL=gpt-4o
MAX_CONTEXT_TOKENS=50000
DEBUG=false

# ============================================================================
# A2A Configuration
# ============================================================================

A2A_ENABLED=true
A2A_SERVER_URL=http://localhost:9999
A2A_TIMEOUT=10

# A2A Agent Apps - JSON array of downstream agents to discover and route to
# Example: Vivid Commenter agent for Reddit marketing
A2A_AGENT_APPS='[{"agent_app_id":"4906eeb7-9959-414e-84c6-f2445822ebe4","name":"Vivid Commenter","description":"AI-powered Reddit commenter for marketing automation","endpoint_url":"https://par.pixell.global/agents/4906eeb7-9959-414e-84c6-f2445822ebe4","protocol":"grpc","enabled":true,"priority":10}]'

# How often to refresh agent cards (in seconds, 0 to disable)
A2A_CARD_REFRESH_INTERVAL=300

# Use LangGraph AI-native routing (recommended)
USE_LANGGRAPH_UPEE=true

# ============================================================================
# Security (Production)
# ============================================================================

#JWT_SECRET_KEY=your-production-jwt-secret-32-chars-minimum
#HMAC_SECRET_KEY=your-production-hmac-secret-32-chars-minimum

# ============================================================================
# Performance
# ============================================================================

#MAX_CONCURRENT_REQUESTS=150
#REQUEST_TIMEOUT=30

# ============================================================================
# Python Environment
# ============================================================================

PYTHONUNBUFFERED=1
